using Microsoft.Data.Sqlite;
using System;
using System.IO;
using System.Windows.Forms;

namespace вход_курсач
{
    internal static class Program
    {
        public static string ConnectionString { get; private set; }

        static void Main()
        {
            ApplicationConfiguration.Initialize();

            try
            {
                // Создаем папку Data рядом с приложением
                string dataFolder = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Data");
                if (!Directory.Exists(dataFolder))
                    Directory.CreateDirectory(dataFolder);

                // Путь к файлу базы данных
                string dbFile = Path.Combine(dataFolder, "TPPO.db");
                ConnectionString = $"Data Source={dbFile}";

                // Если базы нет - создаем
                if (!File.Exists(dbFile))
                {
                    CreateDatabase();
                }

                Application.Run(new Login());
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Ошибка: {ex.Message}\n\n" +
                    "Попробуйте запустить от имени администратора",
                    "Ошибка", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private static void CreateDatabase()
        {
            using (var conn = new SqliteConnection(ConnectionString))
            {
                conn.Open();

                string sql = @"
                    PRAGMA foreign_keys = ON;

                    CREATE TABLE IF NOT EXISTS Filials (
                        Id INTEGER PRIMARY KEY AUTOINCREMENT,
                        Name TEXT NOT NULL UNIQUE,
                        Address TEXT NOT NULL,
                        Contact TEXT NOT NULL,
                        Manager TEXT NOT NULL
                    );

                    -- Примеры филиалов
                    INSERT OR IGNORE INTO Filials (Id, Name, Address, Contact, Manager) VALUES
                        (1, 'Минское УМГ', 'ул. Некрасова, д. 9, Минск', '+375 17-500-34-62', 'Копец Виталий Анатольевич'),
                        (2, 'Оршанское УМГ', 'ул. Могилевская, д. 22, г. Орша', '+375 216-29-02-62', 'Мазурчик Денис Анатольевич'),
                        (3, 'Крупское УМГ', 'ул. Знаменская, д. 6, Крупки', '+375 1796-4-25-71', 'Ермачёнок Юрий Владимирович'),
                        (4, 'Несвижское УМГ', 'ул. Вокзальная, д. 3, Несвиж', '+375 1770-6-22-62', 'Лапин Сергей Михайлович'),
                        (5, 'Кобринское УМГ', 'ул. Интернациональная, д. 78, Кобрин', '+375 1642-2-10-72', 'Кольков Валерий Валерьевич'),
                        (6, 'Слонимское УМГ', 'ул. Промышленная, д. 13, Слоним', '+375 1562-7-22-62', 'Беляков Владимир Евгеньевич'),
                        (7, 'Гомельское УМГ', 'ул. Советская, д. 109, Гомель', '+375 232-49-02-62', 'Хлопонин Юрий Викторович'),
                        (8, 'Осиповичское УМГ', 'ул. Сумченко, д. 2, Осиповичи', '+375 2235-55-04-2', 'Можиловский Сергей Сергеевич');

                    CREATE TABLE IF NOT EXISTS Users (
                        Id INTEGER PRIMARY KEY AUTOINCREMENT,
                        Name TEXT NOT NULL,
                        Surname TEXT NOT NULL,
                        SecondName TEXT NOT NULL,
                        Filial INTEGER NOT NULL,
                        TeamNum INTEGER,
                        Status INTEGER NOT NULL,
                        Login TEXT UNIQUE NOT NULL,
                        Password TEXT NOT NULL,
                        CreatedAt DATETIME DEFAULT CURRENT_TIMESTAMP
                        -- При желании можно добавить: , FOREIGN KEY (Filial) REFERENCES Filials(Id)
                    );

                    -- Администратор (пример). Филиал 1 указан выше.
                    INSERT OR IGNORE INTO Users (Id, Name, Surname, SecondName, Filial, TeamNum, Status, Login, Password)
                    VALUES (1, 'Админ', 'Админов', 'Админович', 1, 1, 6, 'admin', 'admin');

                    CREATE TABLE IF NOT EXISTS Status_and_RoleName (
                        Status INTEGER PRIMARY KEY,
                        RoleName TEXT NOT NULL
                    );

                    INSERT OR IGNORE INTO Status_and_RoleName (Status, RoleName) VALUES
                        (0, 'Заявка (не подтверждён)'),
                        (1, 'Работник'),
                        (2, 'Отдел кадров'),
                        (3, 'Начальник смены'),
                        (4, 'Бухгалтер'),
                        (5, 'Нач. филиала / зам'),
                        (6, 'Администратор');

                    -- Таблица заявок на создание аккаунта/обработку
                    CREATE TABLE IF NOT EXISTS Requests (
                        Id INTEGER PRIMARY KEY AUTOINCREMENT,
                        UserId INTEGER NOT NULL,
                        RequestStatus INTEGER NOT NULL DEFAULT 0, -- 0 = новое, 1 = принято, 2 = отклонено
                        CreatedAt DATETIME DEFAULT CURRENT_TIMESTAMP,
                        ProcessedBy INTEGER,
                        ProcessedAt DATETIME,
                        Comment TEXT,
                        FOREIGN KEY (UserId) REFERENCES Users(Id)
                    );
                    ";

                using (var cmd = new SqliteCommand(sql, conn))
                {
                    cmd.ExecuteNonQuery();
                }
            }
        }
    }
}

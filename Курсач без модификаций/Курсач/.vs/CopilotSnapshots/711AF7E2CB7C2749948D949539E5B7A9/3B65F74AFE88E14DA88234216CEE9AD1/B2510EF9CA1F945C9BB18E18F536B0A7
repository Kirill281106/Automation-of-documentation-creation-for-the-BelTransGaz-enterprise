using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Text;
using System.Windows.Forms;

namespace вход_курсач
{
    public partial class Authorization : Form
    {
        private DB _db;

        public Authorization()
        {
            InitializeComponent();
            _db = new DB(Program.ConnectionString);
            this.Load += Authorization_Load;
        }

        private void Authorization_Load(object sender, EventArgs e)
        {
            // Загрузим список филиалов для ComboBox (Id и Name)
            using (var conn = new Microsoft.Data.Sqlite.SqliteConnection(Program.ConnectionString))
            {
                try
                {
                    conn.Open();
                    var filials = conn.QueryMultiple("SELECT Id, Name FROM Filials ORDER BY Name");
                }
                catch
                {
                    // игнорируем ошибки при загрузке филиалов
                }
            }

            // Попробуем получить данные через DB класс
            try
            {
                using (var conn = new Microsoft.Data.Sqlite.SqliteConnection(Program.ConnectionString))
                {
                    conn.Open();
                    var list = Dapper.SqlMapper.Query(conn, "SELECT Id, Name FROM Filials ORDER BY Name");
                    FilialCombo.DisplayMember = "Name";
                    FilialCombo.ValueMember = "Id";
                    FilialCombo.DataSource = list.AsList();
                }
            }
            catch
            {
                // если не удалось — оставим комбобокс пустым
            }
        }

        public void NewUser()
        {
            // устаревший
        }

        private void button1_Click(object sender, EventArgs e)
        {
            string login = LoginTxt.Text?.Trim();
            string password = PasswordTxt.Text?.Trim();
            string name = NameTxt.Text?.Trim();
            string surname = SurnameTxt.Text?.Trim();
            string secondName = SecondNameTxt.Text?.Trim();

            if (string.IsNullOrWhiteSpace(login) || string.IsNullOrWhiteSpace(password) ||
                string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(surname))
            {
                MessageBox.Show("Заполните обязательные поля: имя, фамилия, логин и пароль", "Ошибка", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            // Получаем выбранный филиал. Если ничего не выбрано — передаём пустую строку (DB.NewUser обработает как 0)
            string filialName = string.Empty;
            if (FilialCombo.Items.Count > 0 && FilialCombo.SelectedItem != null)
            {
                // SelectedItem - это динамический объект с полями Id и Name
                var sel = FilialCombo.SelectedItem;
                try
                {
                    var nameProp = sel.GetType().GetProperty("Name");
                    if (nameProp != null)
                        filialName = nameProp.GetValue(sel)?.ToString() ?? string.Empty;
                }
                catch { }
            }

            var created = _db.NewUser(name, surname, secondName, login, password, filialName);
            if (created == null)
            {
                MessageBox.Show("Пользователь с таким логином уже существует или произошла ошибка.", "Ошибка", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            MessageBox.Show("Заявка отправлена. Дождитесь подтверждения.", "OK", MessageBoxButtons.OK, MessageBoxIcon.Information);
            this.Close();
        }
    }
}

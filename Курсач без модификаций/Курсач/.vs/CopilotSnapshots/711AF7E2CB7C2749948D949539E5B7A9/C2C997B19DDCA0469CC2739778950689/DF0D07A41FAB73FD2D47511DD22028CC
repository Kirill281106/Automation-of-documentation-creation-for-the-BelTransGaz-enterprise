using Dapper;
using Microsoft.Data.Sqlite;
using System.Data;
namespace вход_курсач
{
    internal class DB
    {
        private readonly string _connection;

        public DB(string connection)
        {
            _connection = connection;
        }

        public IEnumerable<dynamic> GetFilials()
        {
            using (IDbConnection db = new SqliteConnection(_connection))
            {
                db.Open();
                var list = db.Query("SELECT Id, Name FROM Filials ORDER BY Name").ToList();
                if (list.Count == 0)
                {
                    try
                    {
                        db.Execute(@"INSERT INTO Filials (Name, Address, Contact, Manager) VALUES
                            ('Минское УМГ', 'ул. Некрасова, д. 9, Минск', '+3751750003462', 'Копец Виталий А.'),
                            ('Оршанское УМГ', 'ул. Могилевская, д. 22, г. Орша', '+375216290262', 'Мазурчик Д.'),
                            ('Крупское УМГ', 'ул. Знаменская, д. 6, Крупки', '+375179642571', 'Ермачёнок Ю.В.');");
                    }
                    catch
                    {
                        // если таблицы нет или ошибка — игнорируем
                    }

                    list = db.Query("SELECT Id, Name FROM Filials ORDER BY Name").ToList();
                }

                return list;
            }
        }

        public ClassUser Authenticate(string login, string password)
        {
            using (IDbConnection db = new SqliteConnection(_connection))
            {
                string sql = @"SELECT * FROM Users
                               WHERE Login = @Login AND Password = @Password";

                return db.QueryFirstOrDefault<ClassUser>(sql, new
                {
                    Login = login,
                    Password = password
                });
            }
        }
        public ClassUser NewUser(string name, string surname, string secondName, string login, string password, string Filial)
        {
            using(IDbConnection db = new SqliteConnection(_connection))
            {
                string existsSql = @"SELECT * FROM Users WHERE Login = @Login";
                var existing = db.QueryFirstOrDefault<ClassUser>(existsSql, new { Login = login });
                if (existing != null)
                {
                    return null;
                }

                // Пользователь вводит название филиала, а в таблице Users храним числовой Id филиала.
                // Попытаемся найти Id по названию в таблице Filials (Name -> Id). Если не найдём — используем 0.
                int filialInt = 0;
                if (!string.IsNullOrWhiteSpace(Filial))
                {
                    // Ожидается, что в базе есть таблица Filials с колонками Id (int) и Name (text)
                    var filialId = db.QueryFirstOrDefault<int?>("SELECT Id FROM Filials WHERE Name = @Name", new { Name = Filial });
                    if (filialId.HasValue)
                    {
                        filialInt = filialId.Value;
                    }
                }

                string insertSql = @"INSERT INTO Users (Login, Password, Name, Surname, SecondName, Filial, Status)
                                     VALUES (@Login, @Password, @Name, @Surname, @SecondName, @Filial, @Status);";

                db.Execute(insertSql, new
                {
                    Login = login,
                    Password = password,
                    Name = name,
                    Surname = surname,
                    SecondName = secondName,
                    Filial = filialInt,
                    Status = 0
                });

                // Получаем Id только что созданной записи и возвращаем её
                var idObj = db.ExecuteScalar<long>("SELECT last_insert_rowid();");
                int newId = (int)idObj;

                string selectSql = "SELECT * FROM Users WHERE Id = @Id";
                var createdUser = db.QueryFirstOrDefault<ClassUser>(selectSql, new { Id = newId });

                // Создаём запись-заявку в таблице Requests (новая заявка)
                try
                {
                    db.Execute("INSERT INTO Requests (UserId, RequestStatus) VALUES (@UserId, @Status)", new { UserId = newId, Status = 0 });
                }
                catch
                {
                    // Если таблицы нет или произошла ошибка — игнорируем, но пользователь создан
                }

                return createdUser;
            }
        }
    }
}
